{
  "name": "thinking-patterns",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/main.ts",
    "server:start": "tsx server/main.ts",
    "dev:all": "concurrently -k -n SERVER,APP \"npm run server\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "test:storybook:ci": "vitest run --project storybook",
    "test:all": "npm run typecheck && npm test && npm run test:e2e && npm run test:storybook:ci",
    "format": "prettier --write --log-level warn \"**/*.{ts,tsx,js,cjs,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md}\"",
    "lint": "oxlint --quiet",
    "lint:all": "oxlint",
    "depcruise": "depcruise . --config .dependency-cruiser.cjs --ignore-known --output-type err-long",
    "depcruise:baseline": "depcruise-baseline . --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^13.0.3",
    "elkjs": "^0.12.1",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "concurrently": "^10.0.7",
    "dependency-cruiser": "^18.9.0",
    "http-server": "^14.1.1",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "storybook": "^10.6.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1",
    "ws": "^8.23.0"
  }
}
